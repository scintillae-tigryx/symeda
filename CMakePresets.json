{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "SYMEDA_FLAVOR": "msvc"
      }
    },
    {
      "name": "clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER_TARGET": "x86_64-w64-windows-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "x86_64-w64-windows-gnu",
        "CMAKE_SYSROOT": "$env{SYMEDA_MSYS2}",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "SYMEDA_FLAVOR": "clang"
      }
    },
    {
      "name": "mingw",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "SYMEDA_FLAVOR": "mingw"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc",  "configurePreset": "msvc"  },
    { "name": "clang", "configurePreset": "clang" },
    { "name": "mingw", "configurePreset": "mingw" }
  ]
}
